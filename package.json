{
  "name": "@servicespack/tasks-api",
  "version": "1.0.6",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "build:watch": "npm run build -- --watch",
    "lint": "npx eslint ./src",
    "lint:fix": "npm run lint -- --fix",
    "start": "node -r dotenv/config .",
    "start:dev": "tsx watch --env-file=.env src/index.ts | pino-pretty",
    "test": "vitest run",
    "test:cov": "npm run test -- --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/servicespack/tasks-api.git"
  },
  "author": "Gabriel Rufino <contato@gabrielrufino.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/servicespack/tasks-api/issues"
  },
  "homepage": "https://github.com/servicespack/tasks-api#readme",
  "dependencies": {
    "@mikro-orm/core": "^5.9.8",
    "@mikro-orm/sqlite": "^5.9.8",
    "amqplib": "^0.10.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.8.1",
    "@faker-js/faker": "^9.5.1",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^3.0.13",
    "@types/supertest": "^2.0.16",
    "@vercel/ncc": "^0.38.3",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.22.0",
    "njwt": "^2.0.1",
    "pino-pretty": "^13.0.0",
    "supertest": "^6.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
